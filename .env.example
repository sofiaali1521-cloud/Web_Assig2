# Server Port Configuration
PORT=3002

# MongoDB Connection URI (Local or MongoDB Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/placement_management_db

# Express Session Secret
SESSION_SECRET=your_production_secure_session_secret_key_here

# Environment Mode (development | production)
NODE_ENV=development

# Optional Admin Seeding Credentials (used by npm run seed:admin)
ADMIN_EMAIL=admin@placement.edu
ADMIN_PASSWORD=Admin@123456
