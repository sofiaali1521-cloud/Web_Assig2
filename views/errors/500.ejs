<%- include('../partials/header') %>

<main class="container">
  <div class="hero" style="border-left: 4px solid #f59e0b;">
    <span class="badge" style="background-color: #fef3c7; color: #d97706;"><%= typeof statusCode !== 'undefined' ? statusCode : 500 %> - Server Error</span>
    <h1>An Unexpected Error Occurred</h1>
    <p><%= typeof message !== 'undefined' ? message : 'Internal Server Error' %></p>
    <% if (typeof error !== 'undefined' && error.stack) { %>
      <pre style="text-align: left; background: #1e293b; color: #f8fafc; padding: 1rem; border-radius: 6px; overflow-x: auto; font-size: 0.85rem; margin-top: 1rem;"><%= error.stack %></pre>
    <% } %>
    <a href="/" style="display: inline-block; margin-top: 1rem; color: var(--primary-color); font-weight: 600; text-decoration: none;">&larr; Return to Home</a>
  </div>
</main>

<%- include('../partials/footer') %>
