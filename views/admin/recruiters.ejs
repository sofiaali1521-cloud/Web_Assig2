<%- include('../partials/header') %>

<main class="container">
  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem; flex-wrap: wrap; gap: 1rem;">
    <div>
      <h1 style="font-size: 2rem; color: var(--secondary-color);">Recruiter Verification & Management</h1>
      <p style="color: var(--text-muted);">Verify recruiting companies and authorize drive publishing privileges</p>
    </div>
    
    <!-- Modern Segmented Pill Filter Controls -->
    <div class="nav-pill-container">
      <a href="/admin/recruiters?status=all" class="nav-pill-btn <%= statusFilter === 'all' ? 'active' : '' %>">
        📋 All (<%= recruiters.length %>)
      </a>
      <a href="/admin/recruiters?status=pending" class="nav-pill-btn <%= statusFilter === 'pending' ? 'active-warning' : '' %>">
        ⏳ Pending Review
      </a>
      <a href="/admin/recruiters?status=verified" class="nav-pill-btn <%= statusFilter === 'verified' ? 'active-success' : '' %>">
        ✅ Verified Only
      </a>
    </div>
  </div>

  <% if (typeof success !== 'undefined' && success) { %>
    <div style="background: #dcfce7; border: 1px solid #86efac; color: #166534; padding: 0.75rem 1rem; border-radius: 8px; margin-bottom: 1.5rem; font-size: 0.9rem; font-weight: 500;">
      ✔ <%= success %>
    </div>
  <% } %>

  <div class="table-responsive" style="background: var(--bg-card); border-radius: var(--radius-lg); border: 1px solid var(--border-color); overflow-x: auto; box-shadow: var(--shadow-sm);">
    <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 0.95rem;">
      <thead>
        <tr style="background: var(--bg-color); color: var(--secondary-color); font-weight: 700; border-bottom: 1px solid var(--border-color);">
          <th style="padding: 1rem;">Recruiter</th>
          <th style="padding: 1rem;">Company</th>
          <th style="padding: 1rem;">Designation</th>
          <th style="padding: 1rem;">Verification State</th>
          <th style="padding: 1rem;">Account State</th>
          <th style="padding: 1rem; text-align: right;">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% if (recruiters.length === 0) { %>
          <tr>
            <td colspan="6" style="padding: 2.5rem; text-align: center; color: var(--text-muted);">
              No recruiter profiles found matching current filter status.
            </td>
          </tr>
        <% } %>

        <% recruiters.forEach(r => { %>
          <tr style="border-bottom: 1px solid var(--border-color);">
            <td style="padding: 1rem;">
              <strong style="color: var(--secondary-color); display: block;"><%= r.user ? r.user.name : 'Unknown User' %></strong>
              <small style="color: var(--text-muted);"><%= r.user ? r.user.email : '' %></small>
            </td>
            <td style="padding: 1rem;">
              <strong style="color: var(--text-main);"><%= r.company ? (r.company.name || r.company.companyName) : 'Unlinked Company' %></strong>
              <small style="display: block; color: var(--text-muted);"><%= r.company && r.company.location ? r.company.location : '' %></small>
            </td>
            <td style="padding: 1rem; color: var(--text-main);"><%= r.designation %></td>
            <td style="padding: 1rem;">
              <% if (r.verified) { %>
                <span class="badge-status" style="background: rgba(16, 185, 129, 0.15); color: var(--success-color); border: 1px solid rgba(16, 185, 129, 0.3);">
                  ✅ Verified
                </span>
              <% } else { %>
                <span class="badge-status" style="background: rgba(245, 158, 11, 0.15); color: var(--warning-color); border: 1px solid rgba(245, 158, 11, 0.3);">
                  ⏳ Pending
                </span>
              <% } %>
            </td>
            <td style="padding: 1rem;">
              <% if (r.user && r.user.isActive) { %>
                <span style="color: #10b981; font-weight: 700; font-size: 0.85rem;">Active</span>
              <% } else { %>
                <span style="color: #ef4444; font-weight: 700; font-size: 0.85rem;">Deactivated</span>
              <% } %>
            </td>
            <td style="padding: 1rem; text-align: right;">
              <div style="display: inline-flex; gap: 0.4rem; justify-content: flex-end;">
                <% if (!r.verified) { %>
                  <form action="/admin/recruiters/<%= r._id %>/verify" method="POST" style="display: inline;">
                    <button type="submit" class="action-btn action-btn-approve">
                      ✔ Approve
                    </button>
                  </form>
                <% } else { %>
                  <form action="/admin/recruiters/<%= r._id %>/reject" method="POST" style="display: inline;">
                    <button type="submit" class="action-btn action-btn-revoke">
                      🚫 Revoke
                    </button>
                  </form>
                <% } %>

                <% if (r.user) { %>
                  <form action="/admin/users/<%= r.user._id %>/toggle-status" method="POST" style="display: inline;">
                    <button type="submit" class="action-btn action-btn-secondary">
                      <%= r.user.isActive ? '🔒 Deactivate' : '🔓 Activate' %>
                    </button>
                  </form>
                <% } %>
              </div>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
</main>

<%- include('../partials/footer') %>
